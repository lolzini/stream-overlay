---
import Layout from "@components/layout.astro";
import CreditSection from "./components/credit-section.astro";
import CommunitySection from "./components/community-section.astro";

const sections = [
  {
    title: "Soundtrack",
    items: ["Playlists del shutú"],
  },
  {
    title: "Fotografía",
    items: ["OBS", "Astro", "Veadotube"],
  },
  {
    title: "Dirección",
    items: ["lolzini", "el chat"],
  },
  {
    title: "Producción",
    items: ["lolzini", "la caridad"],
  },
  {
    title: "Asistentes de guión",
    items: ["ChatGPT", "Claude"],
  },
];

import "./styles.css";
---

<Layout class="custom-background h-screen overflow-y-hidden bg-white">
  <div id="container" class="mx-auto my-40 flex text-center opacity-0">
    <div class="flex flex-col gap-64">
      <CommunitySection />

      {
        sections.map((section) => (
          <CreditSection title={section.title} items={section.items} />
        ))
      }
      <section class="my-20 flex flex-col gap-10">
        <p
          class="custom-stroke flex min-h-screen items-center justify-center p-20 text-5xl"
        >
          Ningún programador fue obligado a hacer horas extras durante la
          realización de este stream
        </p>
      </section>
    </div>
  </div>

  <section
    id="profile"
    class:list={[
      "opacity-0",
      "fixed bottom-0 left-0 right-0 top-0 flex h-screen flex-col items-center justify-center",
    ]}
  >
    <div class="relative mx-auto mt-0 w-fit rounded-full border-4 bg-white">
      <img class="max-w-96 rounded-full" src="/img/lovezini-crop.png" alt="" />
    </div>
    <p id="lolzini" class="z-50 -my-20 text-9xl text-[#1a1a1a]">lolzini</p>
  </section>
</Layout>
