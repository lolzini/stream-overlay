---
import { FaYoutube } from "react-icons/fa6";
---

<span class="relative w-10">
  <FaYoutube id="icon" className="custom-shadow absolute" />
</span>

<style>
  #icon {
    top: 0;
    left: 0;

    animation: youtube 10s linear infinite;
  }

  @keyframes youtube {
    0% {
      fill: currentColor;
      transform: scale(1);
    }
    80% {
      fill: currentColor;
      transform: scale(1);
    }
    90% {
      fill: #ff0000;
      transform: scale(1.1);
    }
    100% {
      fill: currentColor;
      transform: scale(1);
    }
  }
</style>
